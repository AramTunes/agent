      '  }\n' +
      '  const delta = Math.round(((current - previous) / previous) * 100);\n' +
      '  if (delta === 0) return { text: "بدون تغییر نسبت به بازه قبل", tone: "text-muted" };\n' +
      '  const good = invert ? delta < 0 : delta > 0;\n' +
      '  return {\n' +
      '    text: `${faNum(`${delta > 0 ? "+" : ""}${delta}`)}٪ نسبت به بازه قبل`,\n' +
