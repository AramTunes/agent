      '  if (avg < 60) return `${faNum(avg)} ثانیه`;\n' +
      '  const minutes = Math.floor(avg / 60);\n' +
      '  const rest = avg % 60;\n' +
      '  if (!rest) return `${faNum(minutes)} دقیقه`;\n' +
      '  return `${faNum(minutes)} دقیقه و ${faNum(rest)} ثانیه`;\n' +
